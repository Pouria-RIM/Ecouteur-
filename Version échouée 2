<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Pitch Listener - More Sensitive</title>
  <style>
    body { font-family: Arial; text-align: center; background: #111; color: #0f0; padding: 50px; }
    button { padding: 20px 40px; font-size: 24px; background: #222; color: #0f0; border: 2px solid #0f0; cursor: pointer; }
    #status { font-size: 26px; margin: 40px; min-height: 100px; }
  </style>
</head>
<body>
  <h1>Pitch Listener (More Sensitive)</h1>
  <p>Hum a steady note loudly and clearly for 3 seconds</p>
  
  <button id="btn">🎤 START LISTENING (3s)</button>
  <div id="status">Ready — Sing a steady "Aaaaah"</div>

  <script>
    const btn = document.getElementById('btn');
    const status = document.getElementById('status');
    let audioContext;

    function detectPitch(buffer, sampleRate) {
      let best = -1, bestCorr = -1;
      const minO = Math.round(sampleRate / 1000);   // allow higher notes
      const maxO = Math.round(sampleRate / 60);

      for (let offset = minO; offset < maxO; offset++) {
        let corr = 0;
        for (let i = 0; i < buffer.length - offset; i++) {
          corr += buffer[i] * buffer[i + offset];
        }
        if (corr > bestCorr) {
          bestCorr = corr;
          best = offset;
        }
      }
      const freq = best === -1 ? null : sampleRate / best;
      return freq;
    }

    btn.onclick = async () => {
      btn.disabled = true;
      status.textContent = "Listening... Sing a steady loud note now";

      if (!audioContext) audioContext = new (window.AudioContext || window.webkitAudioContext)();

      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        const analyser = audioContext.createAnalyser();
        analyser.fftSize = 4096;
        const source = audioContext.createMediaStreamSource(stream);
        source.connect(analyser);

        const data = new Float32Array(analyser.fftSize);

        setTimeout(() => {
          analyser.getFloatTimeDomainData(data);
          stream.getTracks().forEach(t => t.stop());

          const freq = detectPitch(data, audioContext.sampleRate);

          if (freq && freq > 70 && freq < 1800) {
            status.innerHTML = `Detected: <b>${freq.toFixed(1)} Hz</b>`;
            playTone(freq);
          } else {
            status.textContent = "Still no clear pitch. Try louder + steadier note.";
          }
          btn.disabled = false;
        }, 3000);

      } catch(e) {
        status.textContent = "Microphone error.";
        btn.disabled = false;
      }
    };

    function playTone(freq) {
      const now = audioContext.currentTime;
      const osc = audioContext.createOscillator();
      osc.type = 'triangle';
      osc.frequency.value = freq;

      const gain = audioContext.createGain();
      gain.gain.setValueAtTime(0.4, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 10);

      osc.connect(gain).connect(audioContext.destination);
      osc.start(now);
      osc.stop(now + 10);
    }
  </script>
</body>
</html>
